<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- SMS permission for optional OTP auto-read -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Notification permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Wake lock for background synchronization -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Hardware features -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <application
        android:name=".MyTelegramApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme.LiquidGlass"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        tools:targetApi="34">

        <!-- Login Activity - App Entry Point -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Dashboard -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask" />

        <!-- OTP Verification -->
        <activity
            android:name=".OtpVerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Profile Settings -->
        <activity
            android:name=".ProfileSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Bot Management -->
        <activity
            android:name=".BotManagementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Active Sessions -->
        <activity
            android:name=".ActiveSessionsActivity"
            android:exported="false" />

        <!-- Background Sync Service -->
        <service
            android:name=".service.MessageSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:enabled="true" />

        <!-- SMS Receiver for OTP -->
        <receiver
            android:name=".receiver.SmsOtpReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
