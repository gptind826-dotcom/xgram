<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MyTelegramApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme.LiquidGlass"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true">

        <!-- Login Activity - App Entry Point -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Dashboard -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask" />

        <!-- OTP Verification -->
        <activity
            android:name=".OtpVerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Profile Settings -->
        <activity
            android:name=".ProfileSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Bot Management -->
        <activity
            android:name=".BotManagementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Active Sessions -->
        <activity
            android:name=".ActiveSessionsActivity"
            android:exported="false" />

    </application>

</manifest>
